-- === VARIÁVEIS ===
local cursorX, cursorY = 0, 0
local draggingPanel = nil
local touchpadTouch = nil
local lastTouchPos = Vector2.zero
local touchStartPos = Vector2.zero
local speed = 3.2
local lastTapTime = 0
local TAP_THRESHOLD = 0.5
local opcoesVisiveis = true
local clicking = false

-- === AUTO CLICK VARIÁVEIS ===
local autoAtivo = false
local autoThread = nil
local autoCliquesPorSeg = 25   -- CPS padrão (pode ir até 500 sem lag)
local autoAccumulator = 0

-- Níveis de potência (CPS)
local niveisPotencia = {
    {nome = "LENTO",  cps = 10},
    {nome = "MÉDIA",  cps = 25},
    {nome = "RÁPIDO", cps = 60},
    {nome = "FORTE",  cps = 120},
    {nome = "TURBO",  cps = 250},
    {nome = "MÁXIMO", cps = 500},
}
local nivelIndex = 2

local lastSentX, lastSentY = -1, -1

local function centerCursor()
    local vs = workspace.CurrentCamera.ViewportSize
    cursorX = (vs.X / 2) - 26
    cursorY = (vs.Y / 2) - 26
end
centerCursor()

local function updateRobloxCursor(force)
    local cx = math.floor(cursorX + 26)
    local cy = math.floor(cursorY + 26)
    if not force and cx == lastSentX and cy == lastSentY then return end
    lastSentX, lastSentY = cx, cy
    VirtualInputManager:SendMouseMoveEvent(cx, cy, game)
end

-- Clique rápido sem task.wait (usa down+up juntos: sem frame de pausa = sem lag)
local function fastClick()
    local cx = math.floor(cursorX + 26)
    local cy = math.floor(cursorY + 26)
    VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, true, game, 0)
    VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, false, game, 0)
end

local function doClick()
    if clicking then return end
    clicking = true
    local cx = math.floor(cursorX + 26)
    local cy = math.floor(cursorY + 26)
    VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, true, game, 0)
    task.wait(0.03)
    VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, false, game, 0)
    clicking = false
end

local function updateSensLabel()
    sensLabel.Text = string.format("Sens %.2f", speed)
end

local function changeSpeed(delta)
    speed = math.clamp(speed + delta, 0.5, 12)
    updateSensLabel()
end

sensMinus.MouseButton1Click:Connect(function() changeSpeed(-0.25) end)
sensPlus.MouseButton1Click:Connect(function() changeSpeed(0.25) end)

-- === AUTO CLICK POTENTE (baseado em accumulator no RenderStepped) ===
-- Isso evita task.wait acumulado e mantém FPS estável em qualquer CPS.
local function atualizarBotaoAuto()
    if autoAtivo then
        autoBtn.Text = string.format("⚡ AUTO ON (%d cps)", autoCliquesPorSeg)
        autoBtn.BackgroundColor3 = Color3.fromRGB(60, 220, 100)
    else
        autoBtn.Text = "⚡ AUTO OFF"
        autoBtn.BackgroundColor3 = Color3.fromRGB(255, 60, 60)
    end
end

local function atualizarBotaoPotencia()
    local nivel = niveisPotencia[nivelIndex]
    powerBtn.Text = string.format("POTÊNCIA: %s (%d)", nivel.nome, nivel.cps)
    autoCliquesPorSeg = nivel.cps
    if autoAtivo then atualizarBotaoAuto() end
end

-- Loop no RenderStepped: processa cliques acumulados com base em dt real.
-- Sem task.wait = sem lag de scheduler. Custo: 1 verificação por frame.
RunService.RenderStepped:Connect(function(dt)
    if not autoAtivo then return end
    autoAccumulator = autoAccumulator + (dt * autoCliquesPorSeg)
    -- Limita para não explodir se o jogo travar por um frame
    if autoAccumulator > autoCliquesPorSeg * 0.1 then
        autoAccumulator = autoCliquesPorSeg * 0.1
    end
    while autoAccumulator >= 1 do
        fastClick()
        autoAccumulator = autoAccumulator - 1
    end
end)

autoBtn.MouseButton1Click:Connect(function()
    autoAtivo = not autoAtivo
    autoAccumulator = 0
    atualizarBotaoAuto()
end)

powerBtn.MouseButton1Click:Connect(function()
    nivelIndex = nivelIndex + 1
    if nivelIndex > #niveisPotencia then nivelIndex = 1 end
    atualizarBotaoPotencia()
end)

-- === VISIBILIDADE ===
local function setOpcoesVisiveis(estado)
    opcoesVisiveis = estado
    label.Visible = estado
    moveButton.Visible = estado
    sensMinus.Visible = estado
    sensPlus.Visible = estado
    sensLabel.Visible = estado
    autoBtn.Visible = estado
    powerBtn.Visible = estado
    toggleBtn.Text = estado and "👁" or "❌"
end

toggleBtn.MouseButton1Click:Connect(function()
    setOpcoesVisiveis(not opcoesVisiveis)
end)

local function pontoDentro(px, py, obj)
    local ap = obj.AbsolutePosition
    local as = obj.AbsoluteSize
    return px >= ap.X and px <= ap.X + as.X and py >= ap.Y and py <= ap.Y + as.Y
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if input.UserInputType ~= Enum.UserInputType.Touch then return end
    local pos = input.Position

    if moveButton.Visible and pontoDentro(pos.X, pos.Y, moveButton) then
        draggingPanel = input
        lastTouchPos = pos
        return
    end

    if toggleBtn.Visible and pontoDentro(pos.X, pos.Y, toggleBtn) then return end
    if sensMinus.Visible and pontoDentro(pos.X, pos.Y, sensMinus) then return end
    if sensPlus.Visible and pontoDentro(pos.X, pos.Y, sensPlus) then return end
    if autoBtn.Visible and pontoDentro(pos.X, pos.Y, autoBtn) then return end
    if powerBtn.Visible and pontoDentro(pos.X, pos.Y, powerBtn) then return end

    if pontoDentro(pos.X, pos.Y, touchpad) then
        touchpadTouch = input
        lastTouchPos = pos
        touchStartPos = pos
        lastTapTime = tick()
    end
end)

UserInputService.InputChanged:Connect(function(input, gameProcessed)
    if input.UserInputType ~= Enum.UserInputType.Touch then return end
    local pos = input.Position

    if draggingPanel == input then
        local delta = pos - lastTouchPos
        touchpad.Position += UDim2.new(0, delta.X, 0, delta.Y)
        lastTouchPos = pos
        return
    end

    if touchpadTouch == input then
        local delta = pos - lastTouchPos
        cursorX += delta.X * speed
        cursorY += delta.Y * speed
        lastTouchPos = pos
        updateRobloxCursor()
    end
end)

UserInputService.InputEnded:Connect(function(input, gameProcessed)
    if input.UserInputType ~= Enum.UserInputType.Touch then return end

    if touchpadTouch == input then
        local timeHeld = tick() - lastTapTime
        local totalMoved = (input.Position - touchStartPos).Magnitude
        if timeHeld <= TAP_THRESHOLD and totalMoved < 40 then
            doClick()
        end
        touchpadTouch = nil
    end

    if draggingPanel == input then
        draggingPanel = nil
    end
end)

RunService.RenderStepped:Connect(function()
    local vs = workspace.CurrentCamera.ViewportSize
    local nx = math.clamp(cursorX, 0, vs.X - 52)
    local ny = math.clamp(cursorY, 0, vs.Y - 52)
    if nx ~= cursorX or ny ~= cursorY then
        cursorX, cursorY = nx, ny
        updateRobloxCursor()
    end
    visualCursor.Position = UDim2.new(0, cursorX, 0, cursorY)
end)

updateSensLabel()
atualizarBotaoAuto()
atualizarBotaoPotencia()
print("✅ Virtual Mouse + AUTO POTENTE carregado (até 500 CPS sem lag)!")
